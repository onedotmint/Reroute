{
  "name": "reroute",
  "version": "0.1.0-preview.1",
  "description": "Reroute project commands to remote compute while keeping source and coding agents local",
  "repository": { "type": "git", "url": "git+https://github.com/onedotmint/Reroute.git" },
  "homepage": "https://github.com/onedotmint/Reroute#readme",
  "bugs": { "url": "https://github.com/onedotmint/Reroute/issues" },
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "reroute": "bin/reroute.mjs",
    "rerouted": "bin/rerouted.mjs"
  },
  "exports": {
    ".": "./dist/core/contracts.js",
    "./pi": "./adapters/pi.mjs",
    "./omp": "./adapters/omp.mjs",
    "./opencode": "./adapters/opencode.mjs",
    "./deepseek": "./adapters/deepseek.mjs"
  },
  "files": [
    "bin",
    "dist",
    "adapters",
    "assets",
    "README.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "sdk-versions.json",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --check",
    "tools:install": "npm install --prefix .tools --no-save --ignore-scripts --no-audit --no-fund typescript@5.8.3 @types/node@22 @daytona/sdk@0.223.1",
    "typecheck:sdk": "node .tools/node_modules/typescript/bin/tsc --project tests/sdk/tsconfig.json",
    "test": "node --test --test-concurrency=4 tests/unit/*.test.mjs tests/contract/*.test.mjs tests/integration/*.test.mjs tests/harness/*.test.mjs",
    "test:live": "node --test tests/live/*.test.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run check:dist && npm run typecheck && npm run typecheck:sdk && npm run build && npm test",
    "verify:release": "npm run verify && npm run smoke && npm run check:package",
    "smoke": "node bin/reroute.mjs --help",
    "package:source": "node scripts/package.mjs"
  },
  "packageManager": "pnpm@10.11.0"
}
