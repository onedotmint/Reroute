{
  "name": "@onedotmint/reroute",
  "version": "0.4.2",
  "description": "Keep Pi or DeepSeek Harness and source local; offload build, test and compute through native remote tools",
  "keywords": [
    "pi-package",
    "pi-extension",
    "remote-builds",
    "development-tools",
    "dsh-plugin"
  ],
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onedotmint/Reroute.git"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.1-rc.5"
  },
  "bin": {
    "reroute": "bin/reroute.mjs"
  },
  "exports": {
    ".": "./dist/engine.js",
    "./pi": "./adapters/pi.ts",
    "./dsh": {
      "types": "./dist/dsh.d.ts",
      "default": "./dist/dsh.js"
    }
  },
  "pi": {
    "extensions": [
      "./adapters/pi.ts"
    ]
  },
  "files": [
    "bin/reroute.mjs",
    "dist",
    "src",
    "adapters",
    "assets",
    "README.md",
    "DELIVERY.md",
    "LICENSE",
    "NOTICE",
    "docs",
    "cordis.patch.yml"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test --test-concurrency=4 tests/*.test.mjs",
    "test:ssh": "node --test tests/ssh.integration.mjs",
    "test:live": "node tests/live.mjs",
    "smoke": "node tests/smoke.mjs",
    "check:package": "node scripts/check-package.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs",
    "benchmark": "node tests/benchmark.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run smoke",
    "test:dsh": "node --test tests/dsh.integration.mjs tests/dsh-ptc.integration.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@daytona/sdk": "~0.223.1",
    "e2b": "~2.60.0",
    "ignore": "^7.0.12",
    "modal": "~0.11.0",
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs-local": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.20.5",
    "@types/shell-quote": "1.7.5",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/dsh-fs": "0.2.1-rc.5",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.5",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plan-mode": "0.2.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-working-directory": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-plan-mode": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
